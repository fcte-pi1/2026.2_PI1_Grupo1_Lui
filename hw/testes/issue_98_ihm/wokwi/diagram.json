{
  "version": 1,
  "author": "Grupo 1 - PI1 2026.2 (Prof. Lui)",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-pushbutton", "id": "btn_start", "top": 120, "left": -220, "attrs": { "color": "green", "label": "LARGADA (GPIO 15)", "key": "1" } },
    { "type": "wokwi-neopixel", "id": "neopixel", "top": 20, "left": -180, "attrs": { "label": "LED RGB (GPIO 2)" } },
    { "type": "wokwi-buzzer", "id": "buzzer", "top": 60, "left": 180, "attrs": { "label": "BUZZER (GPIO 4)", "volume": "0.1" } },
    { "type": "board-ssd1306", "id": "oled", "top": 180, "left": 180, "attrs": { "i2cAddress": "0x3c" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "esp:5V", "neopixel:VDD", "red", [ "h-80" ] ],
    [ "esp:3V3", "oled:VCC", "red", [ "h80" ] ],

    [ "esp:GND.1", "btn_start:1.l", "black", [ "h-70" ] ],
    [ "esp:GND.1", "neopixel:VSS", "black", [ "h-70" ] ],
    [ "esp:GND.2", "buzzer:1", "black", [ "h70" ] ],
    [ "esp:GND.2", "oled:GND", "black", [ "h70" ] ],

    [ "esp:15", "btn_start:2.l", "green", [ "h-40" ] ],
    [ "esp:2", "neopixel:DIN", "yellow", [ "h-40" ] ],
    [ "esp:4", "buzzer:2", "purple", [ "h40" ] ],

    [ "esp:21", "oled:SDA", "violet", [ "h60" ] ],
    [ "esp:22", "oled:SCL", "violet", [ "h60" ] ]
  ],
  "dependencies": {}
}
