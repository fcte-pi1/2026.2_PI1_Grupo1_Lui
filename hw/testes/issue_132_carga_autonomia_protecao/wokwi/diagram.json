{
  "version": 1,
  "author": "Grupo 1 - PI1 2026.2 (Prof. Lui)",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "board-ssd1306", "id": "oled", "top": 160, "left": 180, "attrs": { "i2cAddress": "0x3c" } },
    { "type": "wokwi-led", "id": "led_fuse", "top": -60, "left": 160, "attrs": { "color": "green", "label": "PROTECAO ATIVA" } },
    { "type": "wokwi-potentiometer", "id": "pot_load", "top": 120, "left": -220, "attrs": { "label": "CARGA MOTORES (mA)", "value": "500" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "esp:3V3", "oled:VCC", "red", [ "h60" ] ],
    [ "esp:3V3", "pot_load:VCC", "red", [ "h-60" ] ],

    [ "esp:GND.1", "oled:GND", "black", [ "h60" ] ],
    [ "esp:GND.2", "led_fuse:C", "black", [ "h40" ] ],
    [ "esp:GND.3", "pot_load:GND", "black", [ "h-60" ] ],

    [ "esp:2", "led_fuse:A", "green", [ "h40" ] ],
    [ "esp:34", "pot_load:SIG", "orange", [ "h-40" ] ],

    [ "esp:21", "oled:SDA", "violet", [ "h60" ] ],
    [ "esp:22", "oled:SCL", "violet", [ "h60" ] ]
  ],
  "dependencies": {}
}
