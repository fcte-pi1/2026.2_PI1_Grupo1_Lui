{
  "version": 1,
  "author": "Grupo 1 - PI1 2026.2 (Prof. Lui)",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-potentiometer", "id": "pot_battery", "top": 120, "left": -220, "attrs": { "label": "BATERIA 7.4V (GPIO 34)", "value": "800" } },
    { "type": "board-ssd1306", "id": "oled", "top": 180, "left": 180, "attrs": { "i2cAddress": "0x3c" } },
    { "type": "wokwi-led", "id": "led_warn", "top": -60, "left": 160, "attrs": { "color": "red", "label": "ALERTA BATERIA" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "esp:3V3", "pot_battery:VCC", "red", [ "h-60" ] ],
    [ "esp:3V3", "oled:VCC", "red", [ "h60" ] ],

    [ "esp:GND.1", "pot_battery:GND", "black", [ "h-60" ] ],
    [ "esp:GND.2", "oled:GND", "black", [ "h60" ] ],
    [ "esp:GND.2", "led_warn:C", "black", [ "h40" ] ],

    [ "esp:34", "pot_battery:SIG", "orange", [ "h-40" ] ],
    [ "esp:4", "led_warn:A", "red", [ "h40" ] ],

    [ "esp:21", "oled:SDA", "violet", [ "h60" ] ],
    [ "esp:22", "oled:SCL", "violet", [ "h60" ] ]
  ],
  "dependencies": {}
}
